# Postgres. Local: postgresql://adpedia:adpedia@localhost:5461/adpedia
DATABASE_URL="postgresql://adpedia:adpedia@localhost:5461/adpedia"

# openssl rand -base64 48
JWT_SECRET="CHANGE-ME-at-least-32-characters-long-random-string"

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# docs/83 — the privacy screen's idle timeout. Not a security boundary; see idle-lock.tsx
IDLE_LOCK_MINUTES=30

# Dev-only seed account. Omit SEED_OWNER_PASSWORD and the seed generates one and prints it.
SEED_OWNER_EMAIL="owner@adpedia.local"
SEED_OWNER_PASSWORD=""

# Web Push. Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:accounts@adpedia.in

# WebAuthn — must match the deployed origin exactly, or assertions fail in production
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# File storage. Unset or "local" writes to ./.storage (gitignored, works out of the box).
# "s3" is not implemented yet — see docs/38 §6.
STORAGE_DRIVER=local
STORAGE_DIR=.storage
