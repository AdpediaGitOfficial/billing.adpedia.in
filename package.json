{
  "name": "adpedia-finance-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "pg:start": "tsx scripts/pg.ts start",
    "pg:stop": "tsx scripts/pg.ts stop",
    "test:db": "npm run db:test:setup && DATABASE_URL=\"postgresql://adpedia:adpedia@localhost:5461/adpedia_test\" vitest run --no-file-parallelism tests/*.integration.test.ts",
    "db:test:setup": "node scripts/pg-admin.mjs recreate adpedia_test && DATABASE_URL=\"postgresql://adpedia:adpedia@localhost:5461/adpedia_test\" prisma migrate deploy && DATABASE_URL=\"postgresql://adpedia:adpedia@localhost:5461/adpedia_test\" SEED_OWNER_EMAIL=test@adpedia.local SEED_OWNER_PASSWORD=test tsx prisma/seed/index.ts",
    "test:all": "npm test && npm run test:db"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed/index.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "15.5.27",
    "playwright": "^1.63.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.23.2",
    "pg": "^8.23.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
